# ShellBrain configuration
# Copy this file to `.env` and edit the values. The `.env` file is git-ignored.

# Which backend to use: openai | llamacpp | ollama
SHELLBRAIN_PROVIDER=llamacpp

# --- Optional generic overrides (apply to whichever provider is selected) ---
# SHELLBRAIN_MODEL=
# SHELLBRAIN_BASE_URL=
# SHELLBRAIN_API_KEY=

# --- OpenAI cloud ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # leave empty to use api.openai.com

# --- llama.cpp server (llama-server) ---
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_API_KEY=EMPTY
LLAMACPP_MODEL=local-model

# --- Ollama (OpenAI-compatible endpoint) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.1:latest
